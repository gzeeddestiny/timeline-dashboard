# Supabase browser configuration (safe publishable values)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
VITE_ADMIN_CONTACT=admin@example.com
VITE_MAINTENANCE_MODE=false
# Local development fallback only; production still requires Supabase access mapping.
VITE_LOCAL_MEMBER_NAME=Tony

# Supabase server-only configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_secret_key
INITIAL_ADMIN_EMAIL=admin@example.com

# Server-side Google Sheets sync and Done writer
GOOGLE_SHEETS_API_KEY=your_google_api_key
APPS_SCRIPT_URL=https://script.google.com/macros/s/your_deployment/exec
APPS_SCRIPT_SHARED_SECRET=replace_with_a_long_random_secret
CRON_SYNC_SECRET=replace_with_at_least_32_random_characters

# Temporary migration-only variables. Never deploy them to the browser or keep
# them in Vercel after `npm run migrate:gist` succeeds.
GIST_ID=temporary_migration_gist_id
GITHUB_TOKEN=temporary_migration_token
